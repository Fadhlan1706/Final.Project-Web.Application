# Buat file .env dengan menyalin isi dari .env.example dan sesuaikan konfigurasi

APP_NAME=SkillSwap
APP_URL=http://localhost
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=skillSwapPlatform
DB_USER=root
DB_PASS=

# Gmail SMTP Configuration for Email Verification
SMTP_USER=someone@student.unsrat.ac.id
SMTP_PASS=your-gmail-app-password

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
